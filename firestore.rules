rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 1500 && !id.matches('^__.*__$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'shahinpc2018@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
          (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'))
      );
    }

    // 1. Admins collection: Superadmin and admin management
    match /admins/{adminId} {
      allow read: if isValidId(adminId) && (isAdmin() || (isSignedIn() && request.auth.uid == adminId));
      allow create, update: if isValidId(adminId) && isAdmin();
      // Safeguard: Never allow deleting the primary administrator UID to prevent lockouts
      allow delete: if isValidId(adminId) && isAdmin() && adminId != request.auth.uid;
    }

    // 2. Users collection: Customers can register with role customer; Admin can manage all; Admin cannot delete own account
    match /users/{userId} {
      allow read: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow create: if isValidId(userId) && (
        isAdmin() ||
        (isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role == 'customer'))
      );
      allow update: if isValidId(userId) && (
        isAdmin() ||
        (isOwner(userId) && 
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
        )
      );
      // Safeguard: Cannot delete the currently logged in admin or any user with admin role
      allow delete: if isValidId(userId) && isAdmin() && userId != request.auth.uid &&
        (!exists(/databases/$(database)/documents/users/$(userId)) || resource.data.role != 'admin');
    }

    // 3. Products collection (READ ONLY for customers, FULL for admin)
    match /products/{productId} {
      allow read: if true;
      allow write: if isValidId(productId) && isAdmin();
    }

    // 4. Orders collection
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(orderId) && isSignedIn() && (
        request.resource.data.userId == request.auth.uid || isAdmin()
      );
      allow update, delete: if isValidId(orderId) && isAdmin();
    }

    // 5. Deliveries collection
    match /deliveries/{deliveryId} {
      allow get: if isValidId(deliveryId) && (isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(deliveryId) && isAdmin();
      allow update: if isValidId(deliveryId) && (
        isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadCount', 'lastDownloadedAt', 'firstDownloadedAt']))
      );
      allow delete: if isValidId(deliveryId) && isAdmin();
    }

    // 6. Settings collection (publicly readable configuration, admin editable)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId) && isAdmin();
    }

    // 7. Complaints collection
    match /complaints/{complaintId} {
      allow get: if isValidId(complaintId) && (isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(complaintId) && isSignedIn() && (
        isAdmin() ||
        (request.resource.data.userId == request.auth.uid &&
         (!('status' in request.resource.data) || request.resource.data.status == 'pending') &&
         (!('adminReply' in request.resource.data) || request.resource.data.adminReply == '' || request.resource.data.adminReply == null))
      );
      allow update: if isValidId(complaintId) && (
        isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'adminReply', 'userId']))
      );
      allow delete: if isValidId(complaintId) && isAdmin();
    }

    // 8. Connection test document
    match /test/{testId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 9. Coupons collection (publicly readable for checkout, admin managed)
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isValidId(couponId) && isAdmin();
    }

    // 10. Business & accounting collections (Admin-only full access for operations and backup/restore)
    match /sales/{id} { allow read, write: if isValidId(id) && isAdmin(); }
    match /purchases/{id} { allow read, write: if isValidId(id) && isAdmin(); }
    match /suppliers/{id} { allow read, write: if isValidId(id) && isAdmin(); }
    match /supplierPayments/{id} { allow read, write: if isValidId(id) && isAdmin(); }
    match /expenses/{id} { allow read, write: if isValidId(id) && isAdmin(); }
    match /stockMovements/{id} { allow read, write: if isValidId(id) && isAdmin(); }
    match /returns/{id} { allow read, write: if isValidId(id) && isAdmin(); }
    match /payments/{id} { allow read, write: if isValidId(id) && isAdmin(); }
    match /accounts/{id} { allow read, write: if isValidId(id) && isAdmin(); }
    match /transactions/{id} { allow read, write: if isValidId(id) && isAdmin(); }
    match /cashTransactions/{id} { allow read, write: if isValidId(id) && isAdmin(); }
  }
}
