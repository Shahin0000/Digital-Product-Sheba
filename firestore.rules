rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        request.auth.token.email == 'shahinpc2018@gmail.com' ||
        request.auth.token.email == 'bajajmotors.chu@gmail.com' ||
        request.auth.token.email == 'admin@digitalproducts.com' ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*admin.*'))
      );
    }

    // 1. Admins collection
    match /admins/{adminId} {
      allow read: if isValidId(adminId) && (isAdmin() || (isSignedIn() && request.auth.uid == adminId));
      allow write: if isValidId(adminId) && isAdmin();
    }

    // 2. Users collection
    match /users/{userId} {
      allow read: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow create: if isValidId(userId) && (
        isAdmin() ||
        (isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role == 'customer'))
      );
      allow update: if isValidId(userId) && (
        isAdmin() ||
        (isOwner(userId) && 
          (!('role' in request.resource.data) || request.resource.data.role == resource.data.role || request.resource.data.role == 'customer')
        )
      );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // 3. Products collection (READ ONLY for customers, FULL for admin)
    match /products/{productId} {
      allow read: if true;
      allow write: if isValidId(productId) && isAdmin();
    }

    // 4. Orders collection
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(orderId) && isSignedIn() && (
        request.resource.data.userId == request.auth.uid || isAdmin()
      );
      allow update, delete: if isValidId(orderId) && isAdmin();
    }

    // 5. Deliveries collection
    match /deliveries/{deliveryId} {
      allow get: if isValidId(deliveryId) && (isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(deliveryId) && isAdmin();
      allow update: if isValidId(deliveryId) && (
        isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadCount', 'lastDownloadedAt', 'firstDownloadedAt']))
      );
      allow delete: if isValidId(deliveryId) && isAdmin();
    }

    // 6. Settings collection (publicly readable configuration, admin editable)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId) && isAdmin();
    }

    // 7. Connection test document
    match /test/{testId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
